{
    "name": "componenta/http-csrf-middleware",
    "description": "CSRF token managers and PSR-15 middleware for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Csrf\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "infection/infection": "^0.35.4",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Middleware\\Csrf\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
        "phpstan": "@php vendor/bin/phpstan analyse src tests --level=max --no-progress",
        "check": [
            "@phpstan",
            "@test"
        ],
        "mutation": "@php vendor/bin/infection --threads=max --min-msi=80 --min-covered-msi=80 --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
